---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import logo from '../assets/logo.jpeg';
import headerLogo from '../assets/lunaria-header.png';
import nicolas from '../assets/nicolas-retrato.png';
import martu from '../assets/martu-retrato.png';
import showcase from '../assets/studio-showcase.png';
import { site, nav, hero, services, projects, about, contact } from '../data/content';

const year = new Date().getFullYear();

---

<Base>
  <div class="intro" aria-label="Lunaria" role="presentation">
    <div class="logo-crop logo-crop--intro">
      <Image src={logo} alt="" width={1600} height={900} loading="eager" class="logo-crop__image" />
    </div>
  </div>
  <header class="header">
    <div class="container header__inner">
      <a href="#inicio" class="brand logo-header" aria-label="Lunaria, inicio">
        <Image src={headerLogo} alt="Lunaria" width={358} height={143} loading="eager" class="logo-header__image" />
      </a>
      <nav class="nav" aria-label="Principal">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <details class="mobile-nav">
        <summary aria-label="Abrir menú de navegación"><span></span><span></span></summary>
        <nav class="mobile-nav__panel" aria-label="Navegación móvil">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </details>
      <a href="#contacto" class="btn btn--small">Escribinos</a>
    </div>
  </header>

  <main id="inicio">
    <section class="hero">
      <div class="container hero__inner">
        <div class="hero__copy">
          <p class="eyebrow"><span class="spark" aria-hidden="true"></span>{hero.eyebrow}</p>
          <h1>{hero.title}</h1>
          <p class="lead">{hero.text}</p>
          <div class="hero__actions">
            <a class="btn" href={hero.cta.href}>{hero.cta.label}</a>
            <a class="btn btn--ghost" href={hero.ctaSecondary.href}>{hero.ctaSecondary.label}</a>
          </div>
        </div>
        <div class="hero__art" aria-label="Muestra visual de los servicios de Lunaria">
          <div class="hero__gallery">
            <figure class="hero__frame hero__frame--identity" style={`--panel-image: url("${showcase.src}"); --panel-position: 0%`}>
              <figcaption><span>01</span> Identidad</figcaption>
            </figure>
            <figure class="hero__frame hero__frame--digital" style={`--panel-image: url("${showcase.src}"); --panel-position: 33.333%`}>
              <figcaption><span>02</span> Digital</figcaption>
            </figure>
            <figure class="hero__frame hero__frame--motion" style={`--panel-image: url("${showcase.src}"); --panel-position: 66.666%`}>
              <figcaption><span>03</span> Motion</figcaption>
            </figure>
            <figure class="hero__frame hero__frame--product" style={`--panel-image: url("${showcase.src}"); --panel-position: 100%`}>
              <figcaption><span>04</span> 3D</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section id="servicios" class="section">
      <div class="container">
        <header class="section__head services__head reveal">
          <p class="eyebrow"><span class="spark" aria-hidden="true"></span>Servicios</p>
          <h2>¿Qué te gustaría crear?</h2>
          <p class="lead">Elegí un área y descubrí cómo podemos darle forma a tu idea.</p>
        </header>
        <div class="services__grid">
          {services.map((s, i) => (
            <a class={`service-card service-card--${s.visual} reveal`} href="#contacto" data-service-contact={s.title} aria-label={`Consultar por ${s.title}`} style={`--reveal-delay: ${i * 70}ms`}>
              <div class={`service-card__art service-art--${s.visual}`} aria-hidden="true">
                <span class="service-card__index">0{i + 1} <i>·</i> LUNARIA</span>
                {s.visual === 'identity' && <div class="service-art__identity"><div class="identity-sheet"><span class="identity-mark">L</span><b>luna</b><small>ESTUDIO CREATIVO</small><div class="identity-swatches"><i></i><i></i><i></i></div></div><span class="identity-orbit"></span><span class="identity-star">✦</span></div>}
                {s.visual === 'web' && <div class="service-art__web"><div class="web-window"><div class="web-window__bar"><i></i><i></i><i></i></div><div class="web-window__content"><small>CASA CALMA</small><b>Un espacio<br />para volver<br />a vos.</b><span>Conocé el espacio ↗</span></div><div class="web-window__sun"></div></div><div class="web-phone"><i></i><b></b><span></span><span></span></div></div>}
                {s.visual === 'social' && <div class="service-art__social"><div class="social-post social-post--back"><span>BRAVA</span><b>rico.<br />simple.<br />de acá.</b><i>✦</i></div><div class="social-post social-post--front"><small>HOY SE COME</small><b>sin vueltas<br />y con ganas.</b><span>UNA MESA, MUCHAS HISTORIAS</span></div><span class="social-spark">✦</span></div>}
                {s.visual === 'motion' && <div class="service-art__motion"><span class="motion-orbit motion-orbit--one"></span><span class="motion-orbit motion-orbit--two"></span><span class="motion-orbit motion-orbit--three"></span><b>darle<br /><em>movimiento</em><br />a una idea<span class="motion-cursor">↗</span></b><i class="motion-dot"></i></div>}
                {s.visual === '3d' && <div class="service-art__product"><span class="product-orb"></span><div class="product-bottle"><i></i><b>LUNA<br /><small>SERUM · 01</small></b></div><span class="product-shadow"></span><i class="product-spark">✦</i></div>}
                {s.visual === 'pack' && <div class="service-art__pack"><span class="pack-sun"></span><div class="pack-box"><i></i><b>LUNA<br /><small>HECHO CON CALMA</small></b></div><div class="pack-side"></div><span class="pack-leaf">✳</span></div>}
              </div>
              <div class="service-card__body">
                <h3 class="service-card__title">{s.title}</h3>
                <p class="service-card__text">{s.text}</p>
                <ul class="service-card__includes">{s.includes.map((item) => <li>{item}</li>)}</ul>
                <span class="service-card__link">Consultar este servicio <span aria-hidden="true">↗</span></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="proyectos" class="section projects-section">
      <div class="container">
        <header class="section__head projects__head reveal">
          <p class="eyebrow"><span class="spark" aria-hidden="true"></span>Proyectos</p>
          <h2>Ideas que toman forma.</h2>
          <p class="lead">Una selección de conceptos visuales para explorar lo que podemos crear en conjunto.</p>
        </header>
        <div class="projects__filters reveal" role="group" aria-label="Filtrar proyectos">
          <button class="projects__filter is-active" type="button" data-project-filter="Todos" aria-pressed="true">Todos</button>
          <button class="projects__filter" type="button" data-project-filter="Identidad" aria-pressed="false">Identidad</button>
          <button class="projects__filter" type="button" data-project-filter="Diseño web" aria-pressed="false">Diseño web · UI/UX</button>
          <button class="projects__filter" type="button" data-project-filter="Motion" aria-pressed="false">Motion</button>
          <button class="projects__filter" type="button" data-project-filter="3D" aria-pressed="false">3D</button>
        </div>
        <div class="projects__grid">
          {projects.map((project, i) => (
            <article class={`project project--${project.art} project--${project.size} reveal`} data-project-category={project.category} style={`--reveal-delay: ${i * 80}ms`}>
              <a class="project__link" href={`/proyectos/${project.slug}/`} aria-label={`Ver más sobre ${'real' in project ? 'el proyecto' : 'el concepto'} ${project.title}`}>
                <div class={`project__art${'cover' in project ? ' project__art--photo' : ''}`} aria-hidden="true">
                  {'cover' in project && <Image src={'thumb' in project ? project.thumb : project.cover} alt="" widths={[480, 800, 1200, 1600]} sizes="(max-width: 899px) 100vw, 680px" class="project__photo" />}
                  {!('cover' in project) && project.art === 'brava' && <div class="project-art-brava"><span>BRAVA</span><small>rico · simple · de acá</small><i>!</i></div>}
                  {project.art === 'casa' && <div class="project-art-casa"><div class="casa-window"><small>CASA CALMA</small><b>Un lugar<br />para volver<br />a vos.</b><span>Descubrí el espacio&nbsp; ↗</span></div></div>}
                  {project.art === 'pausa' && <div class="project-art-pausa"><span>PAUSA</span><i></i><small>respirá · volvé</small></div>}
                  {!('cover' in project) && project.art === 'forma' && <div class="project-art-forma"><span>FORMA<br />01</span><i></i><small>objeto en estudio</small></div>}
                </div>
                <div class="project__meta">
                  <div><span class="project__category">{project.category}</span><h3>{project.title}</h3></div>
                  <span class="project__arrow" aria-hidden="true">↗</span>
                </div>
                <p class="project__description">{project.description}</p>
                <span class="project__sample">{'real' in project ? 'Ver proyecto' : 'Concepto de muestra · Ver proyecto'}</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="nosotros" class="section section--sand">
      <div class="container about">
        <div class="about__copy reveal">
          <p class="eyebrow"><span class="spark" aria-hidden="true"></span>Nosotros</p>
          <h2>{about.title}</h2>
          {about.text.map((t) => <p class="lead">{t}</p>)}
        </div>
        <div class="about__portraits reveal" aria-label="Martina y Nicolás, cofundadores de Lunaria">
          <figure class="about__photo about__photo--martu">
            <Image src={martu} alt="Martina, cofundadora de Lunaria" width={640} class="about__img" />
            <figcaption class="about__caption">Martina<span>Co fundadora</span></figcaption>
          </figure>
          <figure class="about__photo about__photo--nicolas">
            <Image src={nicolas} alt="Nicolás, cofundador de Lunaria" width={640} class="about__img" />
            <figcaption class="about__caption">Nicolás<span>Co fundador</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="contacto" class="section contact">
      <div class="container contact__panel reveal">
        <div class="contact__intro">
          <p class="eyebrow eyebrow--light"><span class="spark" aria-hidden="true"></span>Hablemos</p>
          <h2>{contact.title}</h2>
          <p class="contact__description">{contact.text}</p>
          <div class="contact__links">
            <a class="contact__link" href={`mailto:${site.email}`}>
              <span>Email</span><small>{site.email}</small><b aria-hidden="true">↗</b>
            </a>
            <a class="contact__link" href={site.instagram} target="_blank" rel="noopener">
              <span>{site.instagramHandle}</span><small>Seguinos y conocé nuestro trabajo</small><b aria-hidden="true">↗</b>
            </a>
          </div>
        </div>
        <form id="contact-form" class="contact__form" action={`https://formsubmit.co/ajax/${site.email}`} data-contact-email={site.email} method="post">
          <input type="hidden" name="_subject" value="Nueva consulta desde el sitio de Lunaria" />
          <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" hidden />
          <label>Nombre<input name="nombre" type="text" placeholder="Tu nombre completo" autocomplete="name" required /></label>
          <label>Email<input name="email" type="email" placeholder="tu@email.com" autocomplete="email" required /></label>
          <label>Teléfono<input name="telefono" type="tel" placeholder="Tu teléfono de contacto" autocomplete="tel" required /></label>
          <label>Proyecto<select name="proyecto" required>
            <option value="" disabled selected>¿Qué te gustaría crear?</option>
            <option>Identidad de marca</option><option>Diseño web & UI/UX</option><option>Contenido para redes</option><option>Motion graphics</option><option>Diseño 3D</option><option>Packaging & producto</option><option>Otro proyecto</option>
          </select></label>
          <label>Mensaje<textarea name="mensaje" rows="3" placeholder="Contanos sobre tu proyecto, tiempos y lo que necesitás…" required></textarea></label>
          <button class="contact__submit" type="submit">Enviar mensaje <span aria-hidden="true">✦</span></button>
          <p class="contact__status" data-contact-status role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer__inner">
      <p class="footer__wordmark">Lunaria</p>
      <p>Ideas con identidad. Diseño con intención.</p>
      <nav class="footer__nav" aria-label="Navegación del pie">{nav.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
      <p class="footer__copy">© {year} Lunaria. Todos los derechos reservados.</p>
    </div>
  </footer>

  <div class="whatsapp-widget">
    <details class="whatsapp-picker">
      <summary class="whatsapp-button" aria-label="Elegir un número para escribir por WhatsApp">
        <span class="whatsapp-button__ring" aria-hidden="true"></span>
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3.2a12.5 12.5 0 0 0-10.7 19l-1.4 5.2 5.3-1.4A12.5 12.5 0 1 0 16 3.2Zm0 22.7a10.1 10.1 0 0 1-5.2-1.4l-.4-.2-3.1.8.8-3-.3-.5a10.2 10.2 0 1 1 8.2 4.3Zm5.6-7.6c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-.9 1.2-.3.2-.6.1a8.2 8.2 0 0 1-2.5-1.5 9.4 9.4 0 0 1-1.7-2.1c-.2-.3 0-.5.1-.6l.5-.6.3-.5c.1-.2 0-.4 0-.6s-.7-1.7-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.8.4-.3.3-1.1 1.1-1.1 2.6s1.1 3 1.2 3.2a11 11 0 0 0 4.2 4c.6.2 1.1.4 1.4.5.6.2 1.2.2 1.6.1.5-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4 0-.1-.2-.2-.5-.3Z"/></svg>
      </summary>
      <div class="whatsapp-menu" aria-label="Números de WhatsApp de Lunaria">
        <p>¿Con quién querés hablar?</p>
        <a data-whatsapp-phone="5491151818018" href="https://wa.me/5491151818018">Martu <span>↗</span></a>
        <a data-whatsapp-phone="5493484318457" href="https://wa.me/5493484318457">Nicolás <span>↗</span></a>
      </div>
    </details>
  </div>
</Base>

<script>
  const mobileMenu = document.querySelector('.mobile-nav');
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => mobileMenu.removeAttribute('open'));
  });

  const projectFilters = document.querySelectorAll<HTMLButtonElement>('[data-project-filter]');
  const projectCards = document.querySelectorAll<HTMLElement>('[data-project-category]');
  projectFilters.forEach((filter) => {
    filter.addEventListener('click', () => {
      const category = filter.dataset.projectFilter;
      projectFilters.forEach((item) => {
        const active = item === filter;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      projectCards.forEach((card) => {
        const cardCategory = card.dataset.projectCategory ?? '';
        const visible = category === 'Todos' || (category === 'Diseño web' && cardCategory.includes('Diseño web')) || (category === 'Motion' && cardCategory.includes('Motion')) || (category === '3D' && cardCategory.includes('3D')) || category === 'Identidad' && cardCategory.includes('Identidad');
        card.hidden = !visible;
      });
    });
  });


  const buenosAiresTime = new Intl.DateTimeFormat('es-AR', {
    timeZone: 'America/Argentina/Buenos_Aires',
    hour: 'numeric',
    hourCycle: 'h23',
  });
  const hour = Number(buenosAiresTime.format(new Date()));
  const greeting = hour >= 5 && hour < 12 ? 'Buenos días' : hour >= 12 && hour < 20 ? 'Buenas tardes' : 'Buenas noches';
  const welcome = `${greeting}! ¡Quisiera consultar por sus servicios!`;
  document.querySelectorAll<HTMLAnchorElement>('[data-whatsapp-phone]').forEach((link) => {
    const phone = link.dataset.whatsappPhone;
    if (phone) link.href = `https://wa.me/${phone}?text=${encodeURIComponent(welcome)}`;
  });

  const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
  const projectSelect = contactForm?.querySelector<HTMLSelectElement>('select[name="proyecto"]');
  document.querySelectorAll<HTMLAnchorElement>('[data-service-contact]').forEach((serviceCard) => {
    serviceCard.addEventListener('click', () => {
      const selectedService = serviceCard.dataset.serviceContact;
      if (selectedService && projectSelect && Array.from(projectSelect.options).some((option) => option.value === selectedService)) {
        projectSelect.value = selectedService;
      }
    });
  });
  contactForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submitButton = contactForm.querySelector<HTMLButtonElement>('.contact__submit');
    const status = contactForm.querySelector<HTMLElement>('[data-contact-status]');
    if (!submitButton || !status) return;

    submitButton.disabled = true;
    submitButton.setAttribute('aria-busy', 'true');
    status.dataset.state = 'loading';
    status.textContent = 'Enviando tu mensaje…';

    try {
      const response = await fetch(contactForm.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(contactForm).entries())),
      });
      const result = await response.json() as { success?: boolean | string };
      if (!response.ok || (result.success !== true && result.success !== 'true')) {
        throw new Error('No se pudo enviar el formulario');
      }

      status.dataset.state = 'success';
      status.textContent = '¡Gracias! Recibimos tu mensaje y pronto nos pondremos en contacto.';
      contactForm.reset();
    } catch {
      status.dataset.state = 'error';
      status.textContent = `No pudimos enviar tu mensaje. Probá de nuevo o escribinos a ${contactForm.dataset.contactEmail}.`;
    } finally {
      submitButton.disabled = false;
      submitButton.removeAttribute('aria-busy');
    }
  });

  const revealItems = document.querySelectorAll('.reveal');
  const intro = document.querySelector('.intro');
  const finishIntro = () => {
    intro?.classList.add('intro--finished');
    document.body.classList.remove('intro-lock');
  };
  if (intro) {
    document.body.classList.add('intro-lock');
    window.setTimeout(finishIntro, 1900);
    intro.addEventListener('click', finishIntro, { once: true });
  }

  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('motion-ready');
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.14, rootMargin: '0px 0px -36px 0px' });
    revealItems.forEach((item) => revealObserver.observe(item));

    const cards = document.querySelectorAll('.card, .pillar');
    cards.forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        const bounds = card.getBoundingClientRect();
        const pointer = event as PointerEvent;
        card.style.setProperty('--pointer-x', `${pointer.clientX - bounds.left}px`);
        card.style.setProperty('--pointer-y', `${pointer.clientY - bounds.top}px`);
      });
    });
  }
</script>

