---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import logo from '../assets/logo.jpeg';
import retrato from '../assets/retrato.png';
import showcase from '../assets/studio-showcase.png';
import { site, nav, hero, services, pillars, essence, about, contact } from '../data/content';

const year = new Date().getFullYear();

const icons: Record<string, string> = {
  moon: 'M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z',
  leaf: 'M12 21v-8m0 0c0-4 2-7 6-8-.5 4-2 7-6 8zm0 0c0-3-1.5-5-5-5.5.3 3 2 5 5 5.5z',
  star: 'M12 2c.8 5.5 4.5 9.2 10 10-5.5.8-9.2 4.5-10 10-.8-5.5-4.5-9.2-10-10 5.5-.8 9.2-4.5 10-10z',
  heart: 'M12 20.5S3.5 15 3.5 9A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 8.5 2c0 6-8.5 11.5-8.5 11.5z',
};
---

<Base>
  <div class="intro" aria-label="Lunaria" role="presentation">
    <div class="logo-crop logo-crop--intro">
      <Image src={logo} alt="" width={1600} height={900} loading="eager" class="logo-crop__image" />
    </div>
  </div>
  <header class="header">
    <div class="container header__inner">
      <a href="#inicio" class="brand logo-crop logo-crop--header" aria-label="Lunaria, inicio">
        <Image src={logo} alt="Lunaria" width={1600} height={900} loading="eager" class="logo-crop__image" />
      </a>
      <nav class="nav" aria-label="Principal">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <details class="mobile-nav">
        <summary aria-label="Abrir menú de navegación"><span></span><span></span></summary>
        <nav class="mobile-nav__panel" aria-label="Navegación móvil">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </details>
      <a href="#contacto" class="btn btn--small">Escribinos</a>
    </div>
  </header>

  <main id="inicio">
    <section class="hero">
      <span class="blob blob--hero-a" aria-hidden="true"></span>
      <span class="blob blob--hero-b" aria-hidden="true"></span>
      <div class="container hero__inner">
        <div class="hero__copy">
          <p class="eyebrow"><span class="spark" aria-hidden="true"></span>{hero.eyebrow}</p>
          <h1>{hero.title}</h1>
          <p class="lead">{hero.text}</p>
          <div class="hero__actions">
            <a class="btn" href={hero.cta.href}>{hero.cta.label}</a>
            <a class="btn btn--ghost" href={hero.ctaSecondary.href}>{hero.ctaSecondary.label}</a>
          </div>
        </div>
        <div class="hero__art">
          <Image src={showcase} alt="Muestra visual de identidad de marca, diseño web, motion graphics y producto 3D" class="hero__showcase" loading="eager" />
          <span class="hero__seal" aria-hidden="true">diseño<br />en movimiento</span>
        </div>
      </div>
    </section>

    <section id="servicios" class="section">
      <div class="container">
        <header class="section__head">
          <p class="eyebrow"><span class="spark" aria-hidden="true"></span>Servicios</p>
          <h2>Lo que hacemos.</h2>
        </header>
        <div class="grid grid--services">
          {services.map((s, i) => (
            <article class="card reveal" style={`--reveal-delay: ${i * 90}ms`}>
              <span class="card__num">0{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="esencia" class="section section--navy">
      <div class="container essence">
        <div>
          <p class="eyebrow eyebrow--light"><span class="spark" aria-hidden="true"></span>Esencia de marca</p>
          <h2>{essence.title}</h2>
          {essence.text.map((t) => <p class="lead lead--light">{t}</p>)}
        </div>
        <ul class="pillars">
          {pillars.map((p) => (
            <li class="pillar reveal">
              <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
                <path d={icons[p.icon]} />
              </svg>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="nosotros" class="section section--sand">
      <div class="container about">
        <div class="about__photo">
          <Image src={retrato} alt="Retrato del equipo creativo de Lunaria" width={640} class="about__img" />
        </div>
        <div>
          <p class="eyebrow"><span class="spark" aria-hidden="true"></span>Nosotros</p>
          <h2>{about.title}</h2>
          {about.text.map((t) => <p class="lead">{t}</p>)}
        </div>
      </div>
    </section>

    <section id="contacto" class="section contact">
      <span class="blob blob--contact" aria-hidden="true"></span>
      <div class="container contact__inner">
        <p class="eyebrow"><span class="spark" aria-hidden="true"></span>Contacto</p>
        <h2>{contact.title}</h2>
        <p class="lead">{contact.text}</p>
        <div class="contact__links">
          <a class="btn" href={`mailto:${site.email}`}>Escribir por email</a>
          <a class="btn btn--ghost" href={site.instagram} target="_blank" rel="noopener">Instagram</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer__inner">
      <p class="footer__wordmark">Lunaria</p>
      <p>Ideas con identidad. Diseño con intención.</p>
      <p class="footer__copy">© {year} Lunaria. Todos los derechos reservados.</p>
    </div>
  </footer>
</Base>

<script>
  const mobileMenu = document.querySelector('.mobile-nav');
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => mobileMenu.removeAttribute('open'));
  });

  const revealItems = document.querySelectorAll('.reveal');
  const intro = document.querySelector('.intro');
  const finishIntro = () => {
    intro?.classList.add('intro--finished');
    document.body.classList.remove('intro-lock');
  };
  if (intro) {
    document.body.classList.add('intro-lock');
    window.setTimeout(finishIntro, 1900);
    intro.addEventListener('click', finishIntro, { once: true });
  }

  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('motion-ready');
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.14, rootMargin: '0px 0px -36px 0px' });
    revealItems.forEach((item) => revealObserver.observe(item));
  }
</script>

