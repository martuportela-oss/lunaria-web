---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import logo from '../assets/logo.jpeg';
import nicolas from '../assets/nicolas-retrato.png';
import martu from '../assets/martu-retrato.png';
import showcase from '../assets/studio-showcase.png';
import { site, nav, hero, services, projects, about, contact } from '../data/content';

const year = new Date().getFullYear();

---

<Base>
  <div class="intro" aria-label="Lunaria" role="presentation">
    <div class="logo-crop logo-crop--intro">
      <Image src={logo} alt="" width={1600} height={900} loading="eager" class="logo-crop__image" />
    </div>
  </div>
  <header class="header">
    <div class="container header__inner">
      <a href="#inicio" class="brand logo-crop logo-crop--header" aria-label="Lunaria, inicio">
        <Image src={logo} alt="Lunaria" width={1600} height={900} loading="eager" class="logo-crop__image" />
      </a>
      <nav class="nav" aria-label="Principal">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <details class="mobile-nav">
        <summary aria-label="Abrir menú de navegación"><span></span><span></span></summary>
        <nav class="mobile-nav__panel" aria-label="Navegación móvil">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </details>
      <a href="#contacto" class="btn btn--small">Escribinos</a>
    </div>
  </header>

  <main id="inicio">
    <section class="hero">
      <span class="blob blob--hero-a" aria-hidden="true"></span>
      <span class="blob blob--hero-b" aria-hidden="true"></span>
      <div class="container hero__inner">
        <div class="hero__copy">
          <p class="eyebrow"><span class="spark" aria-hidden="true"></span>{hero.eyebrow}</p>
          <h1>{hero.title}</h1>
          <p class="lead">{hero.text}</p>
          <div class="hero__actions">
            <a class="btn" href={hero.cta.href}>{hero.cta.label}</a>
            <a class="btn btn--ghost" href={hero.ctaSecondary.href}>{hero.ctaSecondary.label}</a>
          </div>
        </div>
        <div class="hero__art">
          <Image src={showcase} alt="Muestra visual de identidad de marca, diseño web, motion graphics y producto 3D" class="hero__showcase" loading="eager" />
          <span class="hero__seal" aria-hidden="true">diseño<br />en movimiento</span>
        </div>
      </div>
    </section>

    <section id="servicios" class="section">
      <div class="container">
        <header class="section__head services__head reveal">
          <p class="eyebrow"><span class="spark" aria-hidden="true"></span>Servicios</p>
          <h2>¿Qué te gustaría crear?</h2>
          <p class="lead">Elegí un área y descubrí cómo podemos darle forma a tu idea.</p>
        </header>
        <div class="services__experience reveal">
          <div class="services__list" role="group" aria-label="Elegí un servicio">
            {services.map((s, i) => (
              <button class="service-option" type="button" data-service-select={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`service-detail-${i}`}>
                <span class="service-option__number">0{i + 1}</span>
                <span class="service-option__title">{s.title}</span>
                <span class="service-option__arrow" aria-hidden="true">↗</span>
              </button>
            ))}
          </div>
          <div class="services__details" aria-live="polite">
            {services.map((s, i) => (
              <article id={`service-detail-${i}`} class={`service-detail service-detail--${s.visual}`} data-service-detail={i} aria-labelledby={`service-title-${i}`} hidden={i !== 0}>
                <div class="service-detail__visual" aria-hidden="true">
                  {s.visual === 'identity' && <svg viewBox="0 0 300 520" preserveAspectRatio="xMidYMid slice"><rect width="300" height="520" fill="#203d54"/><circle cx="150" cy="230" r="110" fill="none" stroke="#f8f1e6" stroke-opacity=".22"/><circle cx="150" cy="230" r="78" fill="none" stroke="#d6b981" stroke-opacity=".55"/><rect x="48" y="112" width="204" height="236" rx="3" fill="#f8f1e6"/><path d="M78 192c0-21 15-37 35-37 18 0 30 12 30 29 0 24-29 39-29 58 0 13 10 22 23 22 10 0 20-6 27-17" fill="none" stroke="#203d54" stroke-width="12" stroke-linecap="round"/><text x="82" y="290" fill="#203d54" font-size="23" font-weight="700" font-family="sans-serif">Lunaria</text><text x="83" y="310" fill="#6b7880" font-size="7" letter-spacing="3" font-family="sans-serif">IDENTIDAD VISUAL</text><rect x="82" y="324" width="25" height="8" fill="#203d54"/><rect x="112" y="324" width="25" height="8" fill="#d6b981"/><rect x="142" y="324" width="25" height="8" fill="#bf8e70"/><path d="M220 90l5 12 12 5-12 5-5 12-5-12-12-5 12-5z" fill="#d6b981"/></svg>}
                  {s.visual === 'web' && <svg viewBox="0 0 300 520" preserveAspectRatio="xMidYMid slice"><rect width="300" height="520" fill="#718a9a"/><circle cx="250" cy="90" r="92" fill="#d6b981" fill-opacity=".35"/><rect x="28" y="130" width="235" height="205" rx="10" fill="#f8f1e6"/><path d="M28 160h235" stroke="#203d54" stroke-opacity=".2"/><circle cx="45" cy="145" r="3" fill="#bf8e70"/><circle cx="57" cy="145" r="3" fill="#d6b981"/><circle cx="69" cy="145" r="3" fill="#203d54"/><rect x="45" y="180" width="87" height="7" rx="3" fill="#203d54"/><rect x="45" y="196" width="62" height="4" rx="2" fill="#9aa7aa"/><rect x="45" y="209" width="72" height="4" rx="2" fill="#9aa7aa"/><rect x="45" y="228" width="48" height="16" rx="8" fill="#203d54"/><rect x="150" y="177" width="93" height="88" rx="5" fill="#d6b981"/><circle cx="195" cy="218" r="25" fill="#bf8e70"/><rect x="178" y="272" width="50" height="4" rx="2" fill="#203d54"/><rect x="194" y="290" width="60" height="120" rx="12" fill="#203d54"/><rect x="200" y="303" width="48" height="91" rx="5" fill="#f8f1e6"/><rect x="207" y="313" width="34" height="34" rx="4" fill="#d6b981"/><rect x="207" y="355" width="28" height="4" rx="2" fill="#718a9a"/><rect x="207" y="365" width="34" height="4" rx="2" fill="#718a9a"/><circle cx="224" cy="402" r="3" fill="#d6b981"/></svg>}
                  {s.visual === 'social' && <svg viewBox="0 0 300 520" preserveAspectRatio="xMidYMid slice"><rect width="300" height="520" fill="#b98a6a"/><circle cx="64" cy="98" r="95" fill="#d6b981" fill-opacity=".5"/><g transform="rotate(-8 125 260)"><rect x="35" y="145" width="156" height="202" rx="7" fill="#f8f1e6"/><rect x="50" y="161" width="24" height="24" rx="12" fill="#203d54"/><rect x="82" y="166" width="69" height="4" rx="2" fill="#203d54"/><rect x="82" y="175" width="42" height="3" rx="2" fill="#b98a6a"/><rect x="50" y="199" width="126" height="91" fill="#203d54"/><circle cx="111" cy="245" r="30" fill="#d6b981"/><path d="M91 250c12-21 29-28 44-15" fill="none" stroke="#f8f1e6" stroke-width="4" stroke-linecap="round"/><text x="56" y="315" fill="#203d54" font-size="15" font-weight="700" font-family="sans-serif">UN DÍA</text><text x="56" y="330" fill="#203d54" font-size="15" font-weight="700" font-family="sans-serif">MÁS BRAVA</text></g><g transform="rotate(8 207 340)"><rect x="154" y="261" width="112" height="151" rx="7" fill="#203d54"/><rect x="164" y="273" width="92" height="83" fill="#d6b981"/><path d="M178 337l25-40 17 24 14-16 17 32z" fill="#bf8e70"/><rect x="166" y="370" width="62" height="4" rx="2" fill="#f8f1e6"/><rect x="166" y="380" width="78" height="4" rx="2" fill="#f8f1e6" fill-opacity=".6"/></g><path d="M227 110l5 12 12 5-12 5-5 12-5-12-12-5 12-5z" fill="#f8f1e6"/></svg>}
                  {s.visual === 'motion' && <svg viewBox="0 0 300 520" preserveAspectRatio="xMidYMid slice"><rect width="300" height="520" fill="#344c63"/><circle cx="150" cy="242" r="115" fill="none" stroke="#f8f1e6" stroke-opacity=".22"/><circle cx="150" cy="242" r="81" fill="none" stroke="#d6b981" stroke-opacity=".5"/><circle cx="150" cy="242" r="49" fill="#d6b981"/><path d="M51 244c42-87 127-119 199-49M48 278c53 83 147 85 209 10M92 149c54-33 112-18 149 24" fill="none" stroke="#f8f1e6" stroke-width="3" stroke-linecap="round"/><path d="M214 102l6 15 15 6-15 6-6 15-6-15-15-6 15-6z" fill="#bf8e70"/><rect x="42" y="390" width="216" height="54" rx="4" fill="#203d54" stroke="#f8f1e6" stroke-opacity=".25"/><text x="58" y="411" fill="#d6b981" font-size="8" letter-spacing="2" font-family="sans-serif">IDEA EN MOVIMIENTO</text><path d="M59 427h27l8-10 9 16 10-12 8 6h112" fill="none" stroke="#f8f1e6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {s.visual === '3d' && <svg viewBox="0 0 300 520" preserveAspectRatio="xMidYMid slice"><defs><linearGradient id="serviceBottle" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#f0d8ad"/><stop offset="1" stop-color="#bf8e70"/></linearGradient><radialGradient id="serviceOrb"><stop stop-color="#f8f1e6"/><stop offset=".72" stop-color="#d6b981"/><stop offset="1" stop-color="#9a765f"/></radialGradient></defs><rect width="300" height="520" fill="#9a765f"/><circle cx="72" cy="93" r="92" fill="#d6b981" fill-opacity=".32"/><ellipse cx="145" cy="389" rx="99" ry="24" fill="#203d54" fill-opacity=".38"/><circle cx="210" cy="170" r="49" fill="url(#serviceOrb)"/><rect x="76" y="226" width="112" height="148" rx="25" fill="url(#serviceBottle)"/><rect x="105" y="202" width="54" height="31" rx="8" fill="#203d54"/><rect x="115" y="189" width="34" height="16" rx="4" fill="#d6b981"/><rect x="89" y="274" width="86" height="56" rx="5" fill="#f8f1e6"/><text x="103" y="298" fill="#203d54" font-size="13" font-weight="700" font-family="sans-serif">LUNA</text><text x="104" y="313" fill="#718a9a" font-size="6" letter-spacing="2" font-family="sans-serif">SERUM · 01</text><path d="M46 410h210" stroke="#f8f1e6" stroke-opacity=".45"/><circle cx="64" cy="410" r="4" fill="#f8f1e6"/><circle cx="238" cy="410" r="4" fill="#f8f1e6"/></svg>}
                  {s.visual === 'pack' && <svg viewBox="0 0 300 520" preserveAspectRatio="xMidYMid slice"><rect width="300" height="520" fill="#b2a58e"/><circle cx="232" cy="107" r="9" fill="#d6b981"/><ellipse cx="151" cy="390" rx="103" ry="23" fill="#203d54" fill-opacity=".2"/><path d="M67 210l80-42 82 43-81 45z" fill="#f8f1e6"/><path d="M67 210l81 46v104l-81-46z" fill="#d6b981"/><path d="M148 256l81-45v104l-81 45z" fill="#203d54"/><path d="M67 210l80-42v88l-80-46z" fill="#bf8e70"/><path d="M105 218l25-13v29l-25-14z" fill="#f8f1e6"/><text x="163" y="299" fill="#f8f1e6" font-size="13" font-weight="700" font-family="sans-serif">LUNA</text><text x="163" y="313" fill="#d6b981" font-size="6" letter-spacing="2" font-family="sans-serif">HECHO CON CALMA</text><circle cx="211" cy="94" r="48" fill="none" stroke="#f8f1e6" stroke-opacity=".35"/><circle cx="211" cy="94" r="35" fill="none" stroke="#d6b981" stroke-opacity=".55"/><path d="M211 76v36m-18-18h36" stroke="#f8f1e6" stroke-width="2" stroke-linecap="round"/></svg>}
                  <b>0{i + 1}</b>
                </div>
                <div class="service-detail__copy">
                  <p class="service-detail__eyebrow">Servicio 0{i + 1} <span>·</span> Lunaria</p>
                  <h3 id={`service-title-${i}`}>{s.title}</h3>
                  <p class="service-detail__text">{s.text}</p>
                  <p class="service-detail__label">Podemos trabajar en</p>
                  <ul>{s.includes.map((item) => <li>{item}</li>)}</ul>
                  <a class="service-detail__cta" href="#contacto">Hablemos de tu idea <span aria-hidden="true">↗</span></a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="proyectos" class="section projects-section">
      <div class="container">
        <header class="section__head projects__head reveal">
          <p class="eyebrow"><span class="spark" aria-hidden="true"></span>Proyectos</p>
          <h2>Ideas que toman forma.</h2>
          <p class="lead">Una selección de conceptos visuales para explorar lo que podemos crear en conjunto.</p>
        </header>
        <div class="projects__filters reveal" role="group" aria-label="Filtrar proyectos">
          <button class="projects__filter is-active" type="button" data-project-filter="Todos" aria-pressed="true">Todos</button>
          <button class="projects__filter" type="button" data-project-filter="Identidad" aria-pressed="false">Identidad</button>
          <button class="projects__filter" type="button" data-project-filter="Diseño web" aria-pressed="false">Diseño web · UI/UX</button>
          <button class="projects__filter" type="button" data-project-filter="Motion" aria-pressed="false">Motion</button>
          <button class="projects__filter" type="button" data-project-filter="3D" aria-pressed="false">3D</button>
        </div>
        <div class="projects__grid">
          {projects.map((project, i) => (
            <article class={`project project--${project.art} project--${project.size} reveal`} data-project-category={project.category} style={`--reveal-delay: ${i * 80}ms`}>
              <a class="project__link" href={`/proyectos/${project.slug}/`} aria-label={`Ver más sobre el concepto ${project.title}`}>
                <div class="project__art" aria-hidden="true">
                  {project.art === 'brava' && <div class="project-art-brava"><span>BRAVA</span><small>rico · simple · de acá</small><i>!</i></div>}
                  {project.art === 'casa' && <div class="project-art-casa"><div class="casa-window"><small>CASA CALMA</small><b>Un lugar<br />para volver<br />a vos.</b><span>Descubrí el espacio&nbsp; ↗</span></div></div>}
                  {project.art === 'pausa' && <div class="project-art-pausa"><span>PAUSA</span><i></i><small>respirá · volvé</small></div>}
                  {project.art === 'forma' && <div class="project-art-forma"><span>FORMA<br />01</span><i></i><small>objeto en estudio</small></div>}
                </div>
                <div class="project__meta">
                  <div><span class="project__category">{project.category}</span><h3>{project.title}</h3></div>
                  <span class="project__arrow" aria-hidden="true">↗</span>
                </div>
                <p class="project__description">{project.description}</p>
                <span class="project__sample">Concepto de muestra · Ver proyecto</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="nosotros" class="section section--sand">
      <div class="container about">
        <div class="about__copy reveal">
          <p class="eyebrow"><span class="spark" aria-hidden="true"></span>Nosotros</p>
          <h2>{about.title}</h2>
          {about.text.map((t) => <p class="lead">{t}</p>)}
        </div>
        <div class="about__portraits reveal" aria-label="Martina y Nicolás, cofundadores de Lunaria">
          <figure class="about__photo about__photo--martu">
            <Image src={martu} alt="Martina, cofundadora de Lunaria" width={640} class="about__img" />
            <figcaption class="about__caption">Martina<span>Co fundadora</span></figcaption>
          </figure>
          <figure class="about__photo about__photo--nicolas">
            <Image src={nicolas} alt="Nicolás, cofundador de Lunaria" width={640} class="about__img" />
            <figcaption class="about__caption">Nicolás<span>Co fundador</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="contacto" class="section contact">
      <div class="container contact__panel reveal">
        <div class="contact__intro">
          <p class="eyebrow eyebrow--light"><span class="spark" aria-hidden="true"></span>Hablemos</p>
          <h2>{contact.title}</h2>
          <p class="contact__description">{contact.text}</p>
          <div class="contact__links">
            <a class="contact__link" href={`mailto:${site.email}`}>
              <span>Email</span><small>{site.email}</small><b aria-hidden="true">↗</b>
            </a>
            <a class="contact__link" href={site.instagram} target="_blank" rel="noopener">
              <span>{site.instagramHandle}</span><small>Seguinos y conocé nuestro trabajo</small><b aria-hidden="true">↗</b>
            </a>
          </div>
        </div>
        <form id="contact-form" class="contact__form" action={`https://formsubmit.co/ajax/${site.email}`} data-contact-email={site.email} method="post">
          <input type="hidden" name="_subject" value="Nueva consulta desde el sitio de Lunaria" />
          <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" hidden />
          <label>Nombre<input name="nombre" type="text" placeholder="Tu nombre completo" autocomplete="name" required /></label>
          <label>Email<input name="email" type="email" placeholder="tu@email.com" autocomplete="email" required /></label>
          <label>Teléfono<input name="telefono" type="tel" placeholder="Tu teléfono de contacto" autocomplete="tel" required /></label>
          <label>Proyecto<select name="proyecto" required>
            <option value="" disabled selected>¿Qué te gustaría crear?</option>
            <option>Identidad de marca</option><option>Diseño web & UI/UX</option><option>Motion graphics</option><option>Diseño 3D / producto</option><option>Otro proyecto</option>
          </select></label>
          <label>Mensaje<textarea name="mensaje" rows="3" placeholder="Contanos sobre tu proyecto, tiempos y lo que necesitás…" required></textarea></label>
          <button class="contact__submit" type="submit">Enviar mensaje <span aria-hidden="true">✦</span></button>
          <p class="contact__status" data-contact-status role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer__inner">
      <p class="footer__wordmark">Lunaria</p>
      <p>Ideas con identidad. Diseño con intención.</p>
      <nav class="footer__nav" aria-label="Navegación del pie">{nav.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
      <p class="footer__copy">© {year} Lunaria. Todos los derechos reservados.</p>
    </div>
  </footer>

  <div class="whatsapp-widget">
    <details class="whatsapp-picker">
      <summary class="whatsapp-button" aria-label="Elegir un número para escribir por WhatsApp">
        <span class="whatsapp-button__ring" aria-hidden="true"></span>
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3.2a12.5 12.5 0 0 0-10.7 19l-1.4 5.2 5.3-1.4A12.5 12.5 0 1 0 16 3.2Zm0 22.7a10.1 10.1 0 0 1-5.2-1.4l-.4-.2-3.1.8.8-3-.3-.5a10.2 10.2 0 1 1 8.2 4.3Zm5.6-7.6c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-.9 1.2-.3.2-.6.1a8.2 8.2 0 0 1-2.5-1.5 9.4 9.4 0 0 1-1.7-2.1c-.2-.3 0-.5.1-.6l.5-.6.3-.5c.1-.2 0-.4 0-.6s-.7-1.7-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.8.4-.3.3-1.1 1.1-1.1 2.6s1.1 3 1.2 3.2a11 11 0 0 0 4.2 4c.6.2 1.1.4 1.4.5.6.2 1.2.2 1.6.1.5-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4 0-.1-.2-.2-.5-.3Z"/></svg>
      </summary>
      <div class="whatsapp-menu" aria-label="Números de WhatsApp de Lunaria">
        <p>¿Con quién querés hablar?</p>
        <a data-whatsapp-phone="5491151818018" href="https://wa.me/5491151818018">Martu <span>↗</span></a>
        <a data-whatsapp-phone="5493484318457" href="https://wa.me/5493484318457">Nicolás <span>↗</span></a>
      </div>
    </details>
  </div>
</Base>

<script>
  const mobileMenu = document.querySelector('.mobile-nav');
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => mobileMenu.removeAttribute('open'));
  });

  const projectFilters = document.querySelectorAll<HTMLButtonElement>('[data-project-filter]');
  const projectCards = document.querySelectorAll<HTMLElement>('[data-project-category]');
  projectFilters.forEach((filter) => {
    filter.addEventListener('click', () => {
      const category = filter.dataset.projectFilter;
      projectFilters.forEach((item) => {
        const active = item === filter;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      projectCards.forEach((card) => {
        const cardCategory = card.dataset.projectCategory ?? '';
        const visible = category === 'Todos' || (category === 'Diseño web' && cardCategory.includes('Diseño web')) || (category === 'Motion' && cardCategory.includes('Motion')) || (category === '3D' && cardCategory.includes('3D')) || category === 'Identidad' && cardCategory.includes('Identidad');
        card.hidden = !visible;
      });
    });
  });

  const serviceOptions = document.querySelectorAll<HTMLButtonElement>('[data-service-select]');
  const serviceDetails = document.querySelectorAll<HTMLElement>('[data-service-detail]');
  serviceOptions.forEach((option) => {
    option.addEventListener('click', () => {
      const selected = option.dataset.serviceSelect;
      serviceOptions.forEach((item) => item.setAttribute('aria-pressed', String(item === option)));
      serviceDetails.forEach((detail) => {
        const isSelected = detail.dataset.serviceDetail === selected;
        detail.hidden = !isSelected;
        if (isSelected) {
          detail.classList.remove('service-detail--enter');
          void detail.offsetWidth;
          detail.classList.add('service-detail--enter');
        }
      });
    });
  });

  const buenosAiresTime = new Intl.DateTimeFormat('es-AR', {
    timeZone: 'America/Argentina/Buenos_Aires',
    hour: 'numeric',
    hourCycle: 'h23',
  });
  const hour = Number(buenosAiresTime.format(new Date()));
  const greeting = hour >= 5 && hour < 12 ? 'Buenos días' : hour >= 12 && hour < 20 ? 'Buenas tardes' : 'Buenas noches';
  const welcome = `${greeting}! ¡Quisiera consultar por sus servicios!`;
  document.querySelectorAll<HTMLAnchorElement>('[data-whatsapp-phone]').forEach((link) => {
    const phone = link.dataset.whatsappPhone;
    if (phone) link.href = `https://wa.me/${phone}?text=${encodeURIComponent(welcome)}`;
  });

  const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
  contactForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submitButton = contactForm.querySelector<HTMLButtonElement>('.contact__submit');
    const status = contactForm.querySelector<HTMLElement>('[data-contact-status]');
    if (!submitButton || !status) return;

    submitButton.disabled = true;
    submitButton.setAttribute('aria-busy', 'true');
    status.dataset.state = 'loading';
    status.textContent = 'Enviando tu mensaje…';

    try {
      const response = await fetch(contactForm.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(contactForm).entries())),
      });
      const result = await response.json() as { success?: boolean | string };
      if (!response.ok || (result.success !== true && result.success !== 'true')) {
        throw new Error('No se pudo enviar el formulario');
      }

      status.dataset.state = 'success';
      status.textContent = '¡Gracias! Recibimos tu mensaje y pronto nos pondremos en contacto.';
      contactForm.reset();
    } catch {
      status.dataset.state = 'error';
      status.textContent = `No pudimos enviar tu mensaje. Probá de nuevo o escribinos a ${contactForm.dataset.contactEmail}.`;
    } finally {
      submitButton.disabled = false;
      submitButton.removeAttribute('aria-busy');
    }
  });

  const revealItems = document.querySelectorAll('.reveal');
  const intro = document.querySelector('.intro');
  const finishIntro = () => {
    intro?.classList.add('intro--finished');
    document.body.classList.remove('intro-lock');
  };
  if (intro) {
    document.body.classList.add('intro-lock');
    window.setTimeout(finishIntro, 1900);
    intro.addEventListener('click', finishIntro, { once: true });
  }

  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('motion-ready');
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.14, rootMargin: '0px 0px -36px 0px' });
    revealItems.forEach((item) => revealObserver.observe(item));

    const cards = document.querySelectorAll('.card, .pillar');
    cards.forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        const bounds = card.getBoundingClientRect();
        const pointer = event as PointerEvent;
        card.style.setProperty('--pointer-x', `${pointer.clientX - bounds.left}px`);
        card.style.setProperty('--pointer-y', `${pointer.clientY - bounds.top}px`);
      });
    });
  }
</script>

